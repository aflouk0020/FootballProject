@startuml
title Football Management System – Complete & Accurate UML
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false
skinparam backgroundColor #f9f9f9
skinparam classFontColor #1E2A38
skinparam classBorderColor #47525E
skinparam classBackgroundColor #E8F6F3
skinparam ArrowColor #2E86C1
skinparam packageStyle rectangle


' =====================================================
' MODEL PACKAGE
' =====================================================
package "model" {

    interface FootballEntity {
        + id(): int
        + name(): String
        + entityInfo(): String
    }

    abstract class Person {
        - name: String
        - age: int
        + getName(): String
        + getAge(): int
        + introduce(): void
    }

    class Team implements FootballEntity {
        - id: Integer
        - name: String
        - city: String
        - foundedYear: int
        - players: List<Player>
        + Team(int, String, String, int)
        + Team(String, String, int)
        + addPlayer(Player): void
        + addPlayers(Player... many): void
        + getPlayers(): List<Player>
        + toString(): String
    }

    class Player extends Person implements FootballEntity {
        - id: Integer
        - position: Position
        - teamId: int
        + Player(int, String, int, Position, int)
        + Player(String, int, Position, int)
        + getPosition(): Position
        + getTeamId(): int
        + introduce(): void
    }

    class Coach extends Person implements FootballEntity {
        - id: Integer
        - teamId: int
        + Coach(int, String, int, int)
        + introduce(): void
    }

    enum Position {
        GOALKEEPER
        DEFENDER
        MIDFIELDER
        FORWARD
    }

    class ContractRecord <<record>> {
        playerName: String
        annualSalary: double
        years: int
    }

    class ImmutableSquadSnapshot {
        - teamName: String
        - playerNames: List<String>
        + ImmutableSquadSnapshot(String, List<String>)
        + getTeamName(): String
        + getPlayerNames(): List<String>
    }
}

' =====================================================
' DAO PACKAGE
' =====================================================
package "dao" {

    class DatabaseConnection {
        + get(): Connection
    }

    class DatabaseMigrator {
        + DatabaseMigrator()
        + migrate(): void
    }

    class TeamDAO {
        + addTeamAndReturnId(Team): int
        + getAllTeamsWithPlayers(): List<Team>
        + updateTeam(Team): boolean
        + deleteTeam(int): boolean
    }

    class PlayerDAO {
        + addPlayer(Player): boolean
        + getAllPlayers(): List<Player>
        + updatePlayer(Player): boolean
        + deletePlayer(int): boolean
    }

    class CoachDAO {
        + addCoach(Coach): boolean
        + getAllCoaches(): List<Coach>
        + updateCoach(Coach): boolean
        + deleteCoach(int): boolean
    }
}

' =====================================================
' SERVICE PACKAGE
' =====================================================
package "service" {

    class LeagueService {
        + LeagueService(TeamDAO, PlayerDAO, CoachDAO)
        + simulateLeague(): List<Map<String,Object>>
        + generateLeagueTable(): List<Map<String,Object>>
        + exportJson(String): void
        + exportXml(String): void
        + getAllTeamsSorted(): List<Team>
    }
}

' =====================================================
' UTIL PACKAGE
' =====================================================
package "util" {

    class ExceptionHandler {
        + ExceptionHandler(String)
    }

    class InvalidAgeException

    class DataAccessRuntimeException

    class ValidationUtil {
        + filter(List<Player>, Predicate<Player>): List<Player>
        + isAdult(Player): boolean
        + parseAge(String): int
        + parseYear(String): int
    }

    class EntityPrinter {
        + describe(FootballEntity): String
    }
}

' =====================================================
' GUI PACKAGE
' =====================================================
package "gui" {

    class FootballGUI {
        + FootballGUI()
        + loadAllDataAsync(): void
    }

    class TeamsPlayersPanel {
        + TeamsPlayersPanel(TeamDAO, PlayerDAO)
        + refreshTeams(): void
        + refreshPlayers(): void
        + loadPlayersForSelectedTeam(): void
    }

    class CoachesPanel {
        + CoachesPanel(CoachDAO, TeamDAO)
        + refreshCoaches(): void
        + loadCoachForSelectedTeam(): void
    }

    class LeaguePanel {
        + LeaguePanel(LeagueService)
        + simulate(): void
        + exportJson(): void
        + exportXml(): void
        + refreshTable(): void
        + showSummaryChart(): void
    }

    class ButtonRenderer
}

' =====================================================
' APP PACKAGE
' =====================================================
package "app" {
    class Main {
        + main(String[]): void
    }
}

' =====================================================
' RELATIONSHIPS (ACCURATE TO REAL CODE)
' =====================================================

' MODEL INHERITANCE
FootballEntity <|-- Team
FootballEntity <|-- Player
FootballEntity <|-- Coach
Person <|-- Player
Person <|-- Coach

' ASSOCIATIONS
Team "1" o-- "*" Player
Team "1" o-- "1" Coach

' DAO DEPENDENCIES
DatabaseMigrator --> DatabaseConnection
TeamDAO --> DatabaseConnection
PlayerDAO --> DatabaseConnection
CoachDAO --> DatabaseConnection
TeamDAO --> Team
PlayerDAO --> Player
CoachDAO --> Coach

' SERVICE DEPENDENCIES
LeagueService --> TeamDAO
LeagueService --> PlayerDAO
LeagueService --> CoachDAO

' UTIL DEPENDENCIES
ValidationUtil --> Player
EntityPrinter --> FootballEntity
ExceptionHandler --> ValidationUtil

' GUI DEPENDENCIES
FootballGUI --> TeamsPlayersPanel
FootballGUI --> CoachesPanel
FootballGUI --> LeaguePanel

TeamsPlayersPanel --> TeamDAO
TeamsPlayersPanel --> PlayerDAO

CoachesPanel --> CoachDAO
CoachesPanel --> TeamDAO

LeaguePanel --> LeagueService

ButtonRenderer --> FootballGUI

' APP ENTRYPOINT
Main --> FootballGUI
Main --> DatabaseMigrator

@enduml
